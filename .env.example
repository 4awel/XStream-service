# Шаблон для разработки: cp .env.example .env.local
# NEXT_PUBLIC_* попадают в бандл и видны в браузере — секретов здесь не держим.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# MediaMTX из docker-compose.yml бэкенда
NEXT_PUBLIC_MEDIA_HLS_URL=http://localhost:8888
NEXT_PUBLIC_MEDIA_WEBRTC_URL=http://localhost:8889
